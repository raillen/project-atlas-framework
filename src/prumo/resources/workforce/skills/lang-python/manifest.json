  "risk_level": "medium",
  "modes": [
    "implementation",
    "review",
    "testing"
  ],
  "inputs": [
    "Source code",
    "Project configuration",
    "Task acceptance criteria"
  ],
  "outputs": [
    "Hardened source code",
    "Verification evidence",
    "Test evidence"
  ],
  "requires": [
    "clean-code",
    "testing-quality"
  ],
  "conflicts": [],
  "capabilities": [
    "filesystem.read",
    "filesystem.write",
    "process.spawn"
  ],
  "references": [
    "references/python-type-system.md"
  ],
  "templates": [
    "templates/python-verification-report.md"
  ],
  "checks": [
    "checks/python-rules.md"
  ],
  "scripts": [
    "scripts/verify.sh"
  ],
  "examples": [
    "examples/safe_python.py"
