{
  "risk_rules": [
    {
      "id": "security-risk",
      "when_any": [
        "security"
      ],
      "require_skills": [
        "threat-modeling",
        "secure-coding",
        "security-review"
      ]
    },
    {
      "id": "public-web-risk",
      "when_any": [
        "public-web"
      ],
      "require_skills": [
        "web-security",
        "secure-coding"
      ]
    },
    {
      "id": "financial-risk",
      "when_any": [
        "financial"
      ],
      "require_skills": [
        "threat-modeling",
        "security-review",
        "secure-coding"
      ]
    },
    {
      "id": "privacy-risk",
      "when_any": [
        "privacy"
      ],
      "require_skills": [
        "threat-modeling",
        "secrets-security"
      ]
    },
    {
      "id": "supply-chain-risk",
      "when_any": [
        "supply-chain"
      ],
      "require_skills": [
        "supply-chain-security",
        "dependency-management"
      ]
    },
    {
      "id": "performance-risk",
      "when_any": [
        "performance",
        "performance-critical"
      ],
      "require_skills": [
        "benchmarking",
        "performance-native"
      ]
    },
    {
      "id": "accessibility-risk",
      "when_any": [
        "accessibility"
      ],
      "require_skills": [
        "accessibility",
        "keyboard-accessibility",
        "contrast"
      ]
    }
  ]
}