{
  "ai": {
    "autonomy": "agentic",
    "orchestrator": "prumo",
    "preferred_models": [
      {
        "id": "google/gemini-2.5-pro",
        "provider": "google"
      },
      {
        "id": "anthropic/claude-3-7-sonnet",
        "provider": "anthropic"
      },
      {
        "id": "openai/gpt-4o",
        "provider": "openai"
      }
    ]
  },
  "context": {
    "architecture": "progressive-context-architecture",
    "budget_profile": "medium",
    "deep_recursion": {
      "enabled": false,
      "experimental": true
    },
    "methodology": "lean-progressive-context",
    "mode": "progressive",
    "profiles": {
      "large": {
        "context_hard_tokens": 32000,
        "context_target_tokens": 16000,
        "max_delegation_depth": 1,
        "max_expansion_rounds": 3,
        "output_hard_tokens": 6000,
        "output_target_tokens": 3000
      },
      "medium": {
        "context_hard_tokens": 16000,
        "context_target_tokens": 8000,
        "max_delegation_depth": 1,
        "max_expansion_rounds": 2,
        "output_hard_tokens": 3000,
        "output_target_tokens": 1500
      },
      "small": {
        "context_hard_tokens": 6000,
        "context_target_tokens": 3000,
        "max_delegation_depth": 0,
        "max_expansion_rounds": 1,
        "output_hard_tokens": 1000,
        "output_target_tokens": 500
      }
    },
    "runtime": {
      "completed_context_ttl": "0d",
      "database": ".prumo/runtime/prumo.db",
      "failed_context_ttl": "7d"
    }
  },
  "documentation": {
    "audiences": [
      "user",
      "developer",
      "operations",
      "agent"
    ],
    "canonical_format": "markdown",
    "entrypoint": "docs/PRUMO.md",
    "site": {
      "enabled": true,
      "generated": true,
      "public_internal_views": true,
      "source": "docs"
    },
    "virtual_chunking": true
  },
  "features": [
    "exhaustive-testing",
    "security-contract",
    "clean-architecture",
    "living-plan",
    "continuous-documentation"
  ],
  "framework": {
    "name": "prumo",
    "version": "0.2.0"
  },
  "goals": {
    "active_goal": null,
    "active_phase": "P00"
  },
  "intelligence": {
    "distinguish_observed_estimated": true,
    "enabled": true,
    "path": ".prumo/history/project-intelligence.json",
    "task_reports": true,
    "track_cost": true,
    "track_input_tokens": true,
    "track_output_tokens": true
  },
  "orchestration": {
    "autonomy": "agentic",
    "orchestrator": "prumo",
    "protocol": "POP"
  },
  "project": {
    "description": "Canonical agnostic reference project demonstrating full Prumo v0.4 architecture, exhaustive testing, and complete documentation hierarchy.",
    "name": "reference-project",
    "type": [
      "service",
      "cli",
      "library"
    ]
  },
  "protocol": {
    "compatible": "\u003e=3 \u003c4",
    "version": 3
  },
  "quality": {
    "coverage_minimum": 85,
    "e2e_testing": true,
    "performance_benchmarks": true,
    "security_sast": true,
    "static_analysis": "strict"
  },
  "risk": [
    "security",
    "production-grade"
  ],
  "stack": {
    "frameworks": [
      "clean-architecture"
    ],
    "languages": [
      "agnostic"
    ],
    "runtimes": [
      "container",
      "native"
    ]
  },
  "version": 2
}
